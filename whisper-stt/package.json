{
  "name": "@local/whisper-stt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Whisper speech recognition for the DSH voice input, with Russian support",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
